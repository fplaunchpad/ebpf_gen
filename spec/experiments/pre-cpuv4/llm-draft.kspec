# ebpf_alu.kspec — KeelSpec source for the eBPF arithmetic (ALU) fragment.
#
# ONE source of truth for three artifacts (see spec/DESIGN.md):
#   * F* semantics   — Ebpf.Semantics.{alu_semn, alu_defined,
#                      swap_bits, swap_sem}                       (MS2)
#   * encoding       — Ebpf.Serialize.{cls, op_bits,
#                      swap_imm, encode_insn}                     (MS3)
#   * prose          — derived from `sem`/`defined`, never authored (MS4)
#
# Format, in one paragraph: `enum` declares a finite argument domain of an
# Ebpf.Ast constructor (with the numeric `bits` value and the `enc` encoding
# value each case carries).  A `family` binds ONE Ebpf.Ast constructor; its
# header declares the form axes (whose cartesian product generates the
# instruction instances), the semantic width variables, the operand reads,
# and the encoding fields that are constant across the family; its rows are
# a pipe-separated table, one row per key-enum case, carrying the per-row
# encoding fields plus the `defined` and `sem` expressions.  `#` comments run
# to end of line.  ASCII only; `sem` uses F* spelling (`=`, `<>`,
# `if .. then .. else ..`) so a cell is copy-pasteable into an F* file.
#
# Prose is NEVER authored here.  `cite` lines carry provenance only.
#
# v1 (Linux 7.0 pin): adds the cpuv4 / ISA-version-4 instructions — signed
# division/modulo (SDIV/SMOD, new rows in the existing `alu` family), the
# sign-extending move (MOVSX, new family), and the unconditional byte swap
# (Bswap, a new row in the existing `swap` family).  See RFC 9669 for the
# normative text.

spec ebpf_alu {
  version 1
  isa     "Linux Documentation/bpf/instruction-set.rst (RFC 9669); pinned kernel Linux 7.0"
  host    little-endian     # load-bearing: ToLE = truncate, ToBE/Bswap = reverse
}

# ---------------------------------------------------------------------------
# Argument domains (must match Ebpf.Ast exactly; checked by AST conformance).
#   bits=<n>  the numeric width the case denotes  (-> swap_bits)
#   enc=<b>   the byte the case contributes to the opcode
#
# v1 adds the cpuv4 domains: alu_op gains SDIV, SMOD (appended, so existing
# case positions are undisturbed); swap_kind gains Bswap (appended); the
# movsx_sz enum and the MovSX constructor are new.
# ---------------------------------------------------------------------------

enum width     { W32 : bits=32 enc=0x04 ; W64 : bits=64 enc=0x07 }
enum operand   { reg : enc=0x08 ; imm : enc=0x00 }
enum alu_op    { ADD ; SUB ; MUL ; DIV ; MOD ; AND ; OR ; XOR ; LSH ; RSH ; ARSH ; SDIV ; SMOD }
enum swap_kind { ToLE ; ToBE ; Bswap }
enum swap_sz   { SW16 : bits=16 ; SW32 : bits=32 ; SW64 : bits=64 }
enum movsx_sz  { SX8 : bits=8 ; SX16 : bits=16 ; SX32 : bits=32 }

# ---------------------------------------------------------------------------
# ALU binary operations — 13 ops x {W32,W64} x {reg,imm} = 52 instances.
# opcode = cls + opc + sbit.  `off` used to be a family-wide constant (every
# ALU op has off=0); v1's cpuv4 signed division/modulo (SDIV, SMOD) reuse
# DIV's/MOD's opcode (0x30 / 0x90 respectively) and are distinguished purely
# by off=1 (off=0 is the existing unsigned form), so `off` is now a per-row
# column instead.
# ---------------------------------------------------------------------------

family alu {
  ctor     Alu(w, op, dst:reg, src:operand)
  key      op : alu_op
  axis     w : width, src : operand
  width    n = bits w
  sem      (n; d = dst@n, s = src@n) : bits n
  defined  (n; s)
  enc      cls = w, sbit = src
  cite     RFC 9669 sec. 4.1 (arithmetic instructions, incl. cpuv4 signed division/modulo)
  cite     CONSTRAINTS.md C5, C6, C7, C8, C9, C10, C11
  cols     name | opc  | off | defined | sem
  ADD      | 0x00 | 0   | -       | wrap n (d + s)
  SUB      | 0x10 | 0   | -       | wrap n (d - s)
  MUL      | 0x20 | 0   | -       | wrap n (d * s)
  DIV      | 0x30 | 0   | s <> 0  | if s = 0 then 0 else wrap n (d / s)
  MOD      | 0x90 | 0   | s <> 0  | if s = 0 then d else wrap n (d % s)
  AND      | 0x50 | 0   | -       | logand n d s
  OR       | 0x40 | 0   | -       | logor n d s
  XOR      | 0xa0 | 0   | -       | logxor n d s
  LSH      | 0x60 | 0   | s < n   | wrap n (d * pow2 (s % n))
  RSH      | 0x70 | 0   | s < n   | wrap n (d / pow2 (s % n))
  ARSH     | 0xc0 | 0   | s < n   | wrap n (sval n d / pow2 (s % n))
  SDIV     | 0x30 | 1   | s <> 0  | if sval n s = 0 then 0 else wrap n (trunc_div (sval n d) (sval n s))
  SMOD     | 0x90 | 1   | s <> 0  | if sval n s = 0 then d else wrap n (trunc_mod (sval n d) (sval n s))
}

# ---------------------------------------------------------------------------
# NEG — 2 instances.  Register form only (no immediate NEG in the ISA).
# ---------------------------------------------------------------------------

family neg {
  ctor     Neg(w, dst:reg)
  axis     w : width
  width    n = bits w
  sem      (n; d = dst@n) : bits n
  enc      cls = w, opc = 0x80, sbit = 0x00, off = 0
  cite     RFC 9669 sec. 4.1 (NEG)
  cols     name | defined | sem
  NEG      | -       | wrap n (0 - d)
}

# ---------------------------------------------------------------------------
# MOV — 2 widths x {reg,imm} = 4 instances.  The operand read (imm64 sign-
# extension for W64, imm32 for W32) is part of `src@n`, not of `sem`.
# ---------------------------------------------------------------------------

family mov {
  ctor     Mov(w, dst:reg, src:operand)
  axis     w : width, src : operand
  width    n = bits w
  sem      (n; s = src@n) : bits n
  enc      cls = w, opc = 0xb0, sbit = src, off = 0
  cite     RFC 9669 sec. 4.1 (MOV); CONSTRAINTS.md C10, C11
  cols     name | defined | sem
  MOV      | -       | s
}

# ---------------------------------------------------------------------------
# MOVSX — sign-extending move, cpuv4 (Linux 6.6+).  2 widths x 3 source
# sizes, less the 1 point the ISA excludes (BPF_ALU / W32 has no offset=32
# form — that encoding exists only in BPF_ALU64) = 5 instances.  Reuses
# MOV's opcode (0xb0) with sbit fixed to the register-source bit (0x08 —
# there is no immediate form); the OFFSET field, always 0 for plain MOV,
# here selects the source field width (8/16/32) to sign-extend.  The full
# 64-bit source register is always read (`src@64`); only its low `f` bits
# feed the result, matching the pattern the `swap` family below uses for
# its own always-read-64-bits source.
# ---------------------------------------------------------------------------

family movsx {
  ctor     MovSX(w, sz, dst:reg, src:reg)
  axis     w : width, sz : movsx_sz
  width    n = bits w, f = bits sz
  sem      (n, f; s = src@64) : bits n
  valid    f < n
  exclude  w = W32, sz = SX32   "no offset=32 sign-extension form in the 32-bit (BPF_ALU) class; SX32 exists only in BPF_ALU64 — the verifier rejects offset=32 with the 32-bit class"
  enc      cls = w, opc = 0xb0, sbit = 0x08, off = f
  cite     RFC 9669 sec. 4.1 (MOVSX, cpuv4 / Linux 6.6)
  cols     name  | defined | sem
  MOVSX    | -       | sext f n s
}

# ---------------------------------------------------------------------------
# Byte swaps — 3 kinds x 3 sizes = 9 instances.  The size is carried in imm
# (16/32/64), the kind in the opcode class/source bits.  The whole 64-bit
# destination is read; the result is a bits-<size> value (so the high bits of
# the destination are cleared).  LITTLE-ENDIAN HOST: ToLE is a truncation.
# cpuv4 (Linux 6.6+) adds Bswap, an UNCONDITIONAL byte swap: same opcode
# (0xd0) and source bit (0x00) as ToLE, but in the 64-bit class (cls=0x07)
# instead of the 32-bit class (cls=0x04) — the class is what keeps its
# encoding from colliding with ToLE's.  It reverses bytes regardless of host
# endianness, which on this little-endian-pinned host computes the same
# formula as ToBE.
# ---------------------------------------------------------------------------

family swap {
  ctor     Swap(k, sz, dst:reg)
  key      k : swap_kind
  axis     sz : swap_sz
  width    m = bits sz
  sem      (m; d = dst@64) : bits m
  enc      off = 0, imm = m
  cite     RFC 9669 sec. 4.1 (byte swap); CONSTRAINTS.md C14
  cite     RFC 9669 sec. 4.1 (unconditional byte swap, cpuv4 / Linux 6.6)
  cols     name | cls  | opc  | sbit | defined | sem
  ToLE     | 0x04 | 0xd0 | 0x00 | -       | low m d
  ToBE     | 0x04 | 0xd0 | 0x08 | -       | bswap (m / 8) d
  Bswap    | 0x07 | 0xd0 | 0x00 | -       | bswap (m / 8) d
}
